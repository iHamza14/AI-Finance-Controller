                        </button>
                    </div>
                </div>
                <p class="text-center text-xs text-gray-500 mt-3">AI Finance Controller can make mistakes. Consider verifying flagged exceptions.</p>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
        let uploadedFiles = { 'file-bank': null, 'file-gl': null, 'file-inv': null };

        // Handle enter key to send
        document.getElementById("chat-input").addEventListener("keypress", function(event) {
            if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();
                sendMessage();
            }
        });

        function handleFile(label, input, key) {
            if (input.files.length > 0) {
                uploadedFiles[key] = input.files[0];
                renderPills();
            }
        }

        function renderPills() {
            const container = document.getElementById('file-pills');
            container.innerHTML = '';
            let hasFiles = false;
            for (let key in uploadedFiles) {
                if (uploadedFiles[key]) {
                    hasFiles = true;
                    container.innerHTML += `
                        <div class="flex items-center gap-2 px-3 py-1.5 bg-[#2f2f2f] text-xs font-medium rounded-xl border border-[#424242] text-gray-300 shadow-sm">
                            <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-400"></i>
                            ${uploadedFiles[key].name}
                            <button onclick="removeFile('${key}')" class="ml-1 text-gray-500 hover:text-red-400"><i data-lucide="x" class="w-3 h-3"></i></button>
                        </div>
                    `;
                }
            }
            if (hasFiles) container.classList.remove('hidden');
            else container.classList.add('hidden');
            lucide.createIcons();
        }

        function removeFile(key) {
            uploadedFiles[key] = null;
            document.getElementById(key).value = "";
            renderPills();
        }

        function appendMessage(role, content, rawHTML=false) {
            const history = document.getElementById('chat-history');
            const isUser = role === 'user';
            
            const avatar = isUser 
                ? `<div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center flex-shrink-0"><i data-lucide="user" class="w-5 h-5 text-white"></i></div>`
                : `<div class="w-8 h-8 rounded-full bg-emerald-600 flex items-center justify-center flex-shrink-0"><i data-lucide="bot" class="w-5 h-5 text-white"></i></div>`;
            
            const bgClass = isUser ? 'msg-user' : 'msg-bot';
            const textContent = rawHTML ? content : `<p class="text-gray-200 whitespace-pre-wrap text-[15px] leading-relaxed">${content}</p>`;

            const msgDiv = document.createElement('div');
            msgDiv.className = `px-4 py-6 md:px-12 flex gap-4 ${bgClass} ${!isUser ? 'border-b border-[#2f2f2f]/50' : ''}`;
            msgDiv.innerHTML = `
                ${avatar}
                <div class="flex-1 space-y-4 max-w-4xl overflow-x-auto min-w-0">
                    ${textContent}
                </div>
            `;
            
            history.appendChild(msgDiv);
            lucide.createIcons();
            
            // Scroll to bottom smoothly
            history.scrollTo({ top: history.scrollHeight, behavior: 'smooth' });
            return msgDiv;
        }

        async function sendMessage() {
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            
            // If empty and no files, do nothing
            if (!text && !uploadedFiles['file-bank']) return;
            
            let userContent = text || "Please reconcile the attached ledgers.";
            appendMessage('user', userContent);
            
            input.value = '';
            
            // Validation
            if (!uploadedFiles['file-bank'] || !uploadedFiles['file-gl'] || !uploadedFiles['file-inv']) {
                setTimeout(() => {
                    appendMessage('bot', "I see your request, but I need all 3 files to run a reconciliation. Please attach the **Bank Statement**, **GL Ledger**, and **Invoices** using the paperclip icon menu, then try again.");
                }, 500);
                return;
            }

            const loadingMsg = appendMessage('bot', '<div class="flex items-center gap-3 text-gray-400 text-[15px]"><i data-lucide="loader-2" class="w-5 h-5 animate-spin"></i> Analyzing ledgers and consulting AI agent...</div>', true);

            let formData = new FormData();
            formData.append("bank_statements", uploadedFiles['file-bank']);
            formData.append("gl_ledger", uploadedFiles['file-gl']);
            formData.append("invoices", uploadedFiles['file-inv']);

            try {
                let res = await fetch("/api/reconcile/start/", { method: "POST", body: formData });
                let data = await res.json();
                
                if (data.id) {
                    pollStatus(data.id, loadingMsg);
                } else {
                    loadingMsg.innerHTML = '<div class="flex items-center gap-2 text-red-400"><i data-lucide="alert-circle" class="w-5 h-5"></i> Failed to start job.</div>';
                    lucide.createIcons();
                }
            } catch(e) {
                loadingMsg.innerHTML = `<div class="flex items-center gap-2 text-red-400"><i data-lucide="alert-circle" class="w-5 h-5"></i> Error: ${e.message}</div>`;
                lucide.createIcons();
            }

            // Clear pills after sending
            uploadedFiles = { 'file-bank': null, 'file-gl': null, 'file-inv': null };
            renderPills();
        }

        async function pollStatus(jobId, loadingMsgElement) {
            let interval = setInterval(async () => {
                try {
                    let res = await fetch(`/api/reconcile/status/${jobId}/`);
                    let data = await res.json();
                    
                    if (data.status === "COMPLETED") {
                        clearInterval(interval);
                        loadingMsgElement.remove();
                        renderReportMessage(data.report);
                    } else if (data.status === "FAILED") {
                        clearInterval(interval);
                        loadingMsgElement.innerHTML = `<div class="flex items-center gap-2 text-red-400"><i data-lucide="alert-circle" class="w-5 h-5"></i> Error: ${data.error_message || "Reconciliation failed."}</div>`;
                        lucide.createIcons();
                    }
                } catch(e) {}
            }, 2000);
        }

        function renderReportMessage(report) {
            const matchPct = (report.match_rate * 100).toFixed(1);
            const excPct = (report.exception_rate * 100).toFixed(1);
            
            let summaryHTML = `
                <div class="space-y-4 w-full text-[15px]">
                    <p class="text-gray-200">Reconciliation complete! Here is the summary of the run:</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <div class="p-4 bg-[#2f2f2f] border border-[#424242] rounded-xl">
                            <div class="text-sm text-gray-400 mb-1">Total Transactions</div>
                            <div class="text-2xl font-light text-white">${report.batch_size}</div>
                        </div>
                        <div class="p-4 bg-[#2f2f2f] border border-[#424242] rounded-xl">
                            <div class="text-sm text-gray-400 mb-1">Match Rate</div>
                            <div class="text-2xl font-light text-emerald-400">${matchPct}%</div>
                        </div>
                        <div class="p-4 bg-[#2f2f2f] border border-[#424242] rounded-xl">
                            <div class="text-sm text-gray-400 mb-1">Exceptions</div>
                            <div class="text-2xl font-light text-amber-400">${excPct}%</div>
                        </div>
                    </div>
                    <p class="text-gray-200">I have flagged ${report.exceptions.length} exceptions that required my investigation. Here are my findings:</p>
            `;

            let tableHTML = `
                <div class="w-full border border-[#424242] rounded-xl mt-4 overflow-hidden shadow-lg">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap min-w-max">
                            <thead class="bg-[#2f2f2f] text-gray-400 text-xs uppercase tracking-wider">
                                <tr>
                                    <th class="px-5 py-3 font-medium">Txn ID</th>
                                    <th class="px-5 py-3 font-medium">Date</th>
                                    <th class="px-5 py-3 font-medium">Counterparty</th>
                                    <th class="px-5 py-3 font-medium">AI Verdict</th>
                                    <th class="px-5 py-3 font-medium">Reasoning</th>
                                    <th class="px-5 py-3 font-medium text-right">Amount</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-[#424242] text-gray-300">
            `;

            report.exceptions.forEach(ex => {
                let verdictColor = "bg-[#424242] text-gray-300 border-[#565656]";
                if(ex.agent_verdict === "RESOLVED_WITH_CONFIDENCE") verdictColor = "bg-emerald-500/10 text-emerald-400 border-emerald-500/20";
                if(ex.agent_verdict === "DUPLICATE_FLAG") verdictColor = "bg-amber-500/10 text-amber-400 border-amber-500/20";
                if(ex.agent_verdict === "NEEDS_HUMAN") verdictColor = "bg-red-500/10 text-red-400 border-red-500/20";
                
                let reasonText = ex.reason || "Not processed";
                
                tableHTML += `
                <tr class="hover:bg-[#2f2f2f]/50 transition-colors">
                    <td class="px-5 py-4 font-mono text-gray-500">${ex.txn_id}</td>
                    <td class="px-5 py-4">${new Date(ex.date).toLocaleDateString()}</td>
                    <td class="px-5 py-4">${ex.counterparty}</td>
                    <td class="px-5 py-4"><span class="px-2 py-1 rounded border text-xs font-medium ${verdictColor}">${(ex.agent_verdict || "SKIPPED").replace(/_/g, " ")}</span></td>
                    <td class="px-5 py-4 text-xs text-gray-400 max-w-md truncate" title="${reasonText.replace(/"/g, '&quot;')}">${reasonText}</td>
                    <td class="px-5 py-4 text-right font-mono">$${parseFloat(ex.amount).toFixed(2)}</td>
                </tr>`;
            });

            tableHTML += `</tbody></table></div></div></div>`;
            
            appendMessage('bot', summaryHTML + tableHTML, true);
        }
    
        function toggleAttachMenu() {
            const menu = document.getElementById('dropdown-attach');
            if(menu) menu.classList.toggle('hidden');
        }
        document.addEventListener('click', function(event) {
            const btn = document.getElementById('btn-attach');
            const menu = document.getElementById('dropdown-attach');
            if (btn && menu && !btn.contains(event.target) && !menu.contains(event.target)) {
                menu.classList.add('hidden');
            }
        });
</script>
</body>
